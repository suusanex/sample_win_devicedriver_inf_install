[Version]
Signature="$WINDOWS NT$"
Class=Sample
ClassGuid={12345678-1234-1234-1234-123456789012}
Provider=SampleProvider
DriverVer=01/01/2024,1.0.0.0

[DefaultInstall]
CopyFiles=SampleFiles
AddReg=SampleRegistry

[DefaultInstall.Services]
AddService=SampleService,0x00000002,SampleServiceInstall

[SampleServiceInstall]
DisplayName=Sample Driver Service
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\sampledriver.sys

[SampleFiles]
sampledriver.sys

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
sampledriver.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[SampleRegistry]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,"sampledriver.sys"

[Strings]
DiskName = "Sample Driver Installation Disk"